<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>YN Export India - Dashboard</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, sans-serif;
            color: #172033;

            background:
                radial-gradient(circle at top left,
                    rgba(0, 119, 255, .18),
                    transparent 35%),
                radial-gradient(circle at bottom right,
                    rgba(0, 200, 170, .15),
                    transparent 35%),
                linear-gradient(135deg,
                    #eef6ff,
                    #f7fbff,
                    #edf8f6);
        }

        .container {
            width: 100%;
            max-width: 680px;
            margin: auto;
            padding: 18px 14px 35px;
        }

        /* HEADER */

        .header {
            position: relative;
            overflow: hidden;

            padding: 28px 22px;
            border-radius: 26px;

            background:
                linear-gradient(135deg,
                    #006fc9,
                    #008bd2 55%,
                    #00a88f);

            color: white;

            box-shadow:
                0 15px 35px rgba(0, 100, 180, .20);

            margin-bottom: 18px;
        }

        .header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -70px;
            top: -70px;

            border-radius: 50%;
            background: rgba(255,255,255,.10);
        }

        .brand {
            font-size: 27px;
            font-weight: 800;
            position: relative;
            z-index: 2;
        }

        .welcome {
            margin-top: 8px;
            font-size: 17px;
            opacity: .92;
            position: relative;
            z-index: 2;
        }

        /* STATS */

        .stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-bottom: 16px;
        }

        .stat-card {
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(255,255,255,.8);

            padding: 22px 15px;

            border-radius: 22px;

            text-align: center;

            box-shadow:
                0 10px 28px rgba(30, 70, 100, .08);

            transition: .2s;
        }

        .stat-card:active {
            transform: scale(.98);
        }

        .icon {
            font-size: 30px;
            margin-bottom: 8px;
        }

        .number {
            font-size: 36px;
            font-weight: 800;
            color: #0878c9;
        }

        .label {
            margin-top: 5px;
            font-size: 15px;
            font-weight: 700;
            color: #5b6575;
        }

        /* REFERRAL */

        .referral {
            background: rgba(255,255,255,.94);

            border-radius: 22px;
            padding: 22px;

            text-align: center;

            box-shadow:
                0 10px 28px rgba(30,70,100,.08);

            margin-bottom: 18px;
        }

        .referral-title {
            color: #687386;
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .referral-id {
            display: inline-block;

            padding: 12px 22px;

            border-radius: 14px;

            background: #eaf7ff;
            color: #006fc9;

            font-size: 23px;
            font-weight: 800;

            letter-spacing: 1px;
        }

        /* MENU */

        .menu-title {
            font-size: 18px;
            font-weight: 800;
            margin: 20px 3px 12px;
        }

        .menu {
            display: grid;
            gap: 11px;
        }

        .menu a {
            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 16px 18px;

            background: rgba(255,255,255,.94);

            border-radius: 17px;

            text-decoration: none;
            color: #1e293b;

            font-size: 16px;
            font-weight: 700;

            box-shadow:
                0 7px 20px rgba(30,70,100,.06);

            transition: .2s;
        }

        .menu a:active {
            transform: scale(.98);
        }

        .menu-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .menu-icon {
            width: 38px;
            height: 38px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            background: #eef7ff;

            font-size: 20px;
        }

        .arrow {
            color: #8b98a9;
            font-size: 20px;
        }

        .logout {
            color: #c62828 !important;
        }

        .logout .menu-icon {
            background: #fff0f0;
        }

        /* MOBILE */

        @media (max-width: 450px) {

            .container {
                padding: 12px 10px 30px;
            }

            .header {
                padding: 24px 19px;
            }

            .brand {
                font-size: 24px;
            }

            .stats {
                gap: 10px;
            }

            .stat-card {
                padding: 18px 10px;
            }

            .number {
                font-size: 31px;
            }
        }

        @media (max-width: 350px) {

            .stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <!-- HEADER -->

    <div class="header">

        <div class="brand">
            YN Export India
        </div>

        <div class="welcome">
            Welcome,
            {{ user.first_name|default:user.username }} 👋
        </div>

    </div>


    <!-- TEAM STATS -->

    <div class="stats">

        <div class="stat-card">

            <div class="icon">
                👥
            </div>

            <div class="number">
                {{ direct_team }}
            </div>

            <div class="label">
                Direct Team
            </div>

        </div>


        <div class="stat-card">

            <div class="icon">
                🌐
            </div>

            <div class="number">
                {{ total_team }}
            </div>

            <div class="label">
                Total Team
            </div>

        </div>

    </div>


    <!-- REFERRAL -->

    <div class="referral">

        <div class="referral-title">
            YOUR REFERRAL ID
        </div>

        <div class="referral-id">
            {{ user.referral_id }}
        </div>

    </div>


    <!-- MENU -->

    <div class="menu-title">
        Orders & Notifications
    </div>

    <div class="menu">

        <a href="{% url 'my_orders' %}">

            <div class="menu-left">

                <div class="menu-icon">
                    📦
                </div>

                <span>
                    My Orders
                </span>

            </div>

            <div class="arrow">
                ›
            </div>

        </a>

        <a href="{% url 'notifications' %}">

            <div class="menu-left">

                <div class="menu-icon">
                    🔔
                </div>

                <span>
                    Notifications
                </span>

            </div>

            <div class="arrow">
                ›
            </div>

        </a>

    </div>

    <div class="menu-title">
        Account
    </div>

    <div class="menu">

        <a href="{% url 'profile' %}">

            <div class="menu-left">

                <div class="menu-icon">
                    👤
                </div>

                <span>
                    My Profile
                </span>

            </div>

            <div class="arrow">
                ›
            </div>

        </a>


        <a href="{% url 'wallet_view' %}">

            <div class="menu-left">

                <div class="menu-icon">
                    💰
                </div>

                <span>
                    My Wallet
                </span>

            </div>

            <div class="arrow">
                ›
            </div>

        </a>


        <a href="{% url 'my_orders' %}">

            <div class="menu-left">

                <div class="menu-icon">
                    📦
                </div>

                <span>
                    My Orders
                </span>

            </div>

            <div class="arrow">
                ›
            </div>

        </a>


        <a href="{% url 'notifications' %}">

            <div class="menu-left">

                <div class="menu-icon">
                    🔔
                </div>

                <span>
                    Notifications
                </span>

            </div>

            <div class="arrow">
                ›
            </div>

        </a>


        <a href="{% url 'home' %}">

            <div class="menu-left">

                <div class="menu-icon">
                    🏠
                </div>

                <span>
                    Home
                </span>

            </div>

            <div class="arrow">
                ›
            </div>

        </a>


        <a href="{% url 'logout' %}" class="logout">

            <div class="menu-left">

                <div class="menu-icon">
                    🚪
                </div>

                <span>
                    Logout
                </span>

            </div>

            <div class="arrow">
                ›
            </div>

        </a>

    </div>

</div>

</body>
</html>
