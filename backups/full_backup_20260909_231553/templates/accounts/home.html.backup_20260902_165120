<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="theme-color" content="#063b9e">

<title>YN Commerce India | Best Quality. Best Prices.</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

:root{
    --blue:#063b9e;
    --blue2:#1261e8;
    --deep:#031b52;
    --gold:#ffc400;
    --gold2:#ffb300;
    --white:#ffffff;
    --bg:#f4f7fc;
    --text:#111827;
    --muted:#667085;
    --green:#159447;
    --border:#e4e7ec;
    --shadow:0 10px 30px rgba(6,59,158,.10);
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:var(--bg);
    color:var(--text);
    padding-bottom:105px;
}

a{
    text-decoration:none;
    color:inherit;
}

button,
input{
    font-family:inherit;
}

/* =========================
   HEADER
========================= */

.header{
    background:linear-gradient(135deg,#031b52 0%,#063b9e 55%,#1261e8 100%);
    color:white;
    position:sticky;
    top:0;
    z-index:1000;
    box-shadow:0 6px 25px rgba(0,0,0,.18);
}

.header-main{
    max-width:1400px;
    margin:auto;
    padding:14px 22px;
    display:flex;
    align-items:center;
    gap:18px;
}

.menu-btn{
    width:48px;
    height:48px;
    border-radius:14px;
    border:1px solid rgba(255,255,255,.20);
    background:rgba(255,255,255,.10);
    color:white;
    font-size:25px;
    cursor:pointer;
}

.logo-box{
    min-width:220px;
}

.logo{
    font-size:30px;
    font-weight:900;
    letter-spacing:-1px;
    line-height:1;
}

.logo .white{
    color:white;
}

.logo .gold{
    color:var(--gold);
}

.logo-tagline{
    margin-top:5px;
    font-size:11px;
    font-weight:700;
    color:#dbeafe;
    letter-spacing:.4px;
}

/* SEARCH */

.search-box{
    flex:1;
    max-width:700px;
    height:48px;
    background:white;
    border-radius:12px;
    display:flex;
    align-items:center;
    padding:0 16px;
    box-shadow:0 4px 16px rgba(0,0,0,.10);
}

.search-icon{
    font-size:22px;
    color:#1d4ed8;
    margin-right:12px;
}

.search-box input{
    width:100%;
    border:0;
    outline:0;
    font-size:14px;
    color:#111827;
    background:transparent;
}

.header-actions{
    margin-left:auto;
    display:flex;
    align-items:center;
    gap:10px;
}

.header-icon{
    width:45px;
    height:45px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(255,255,255,.10);
    border:1px solid rgba(255,255,255,.22);
    font-size:21px;
    position:relative;
}

.badge{
    position:absolute;
    top:-3px;
    right:-2px;
    min-width:18px;
    height:18px;
    border-radius:20px;
    background:#ef3340;
    color:white;
    font-size:10px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:800;
}

/* =========================
   MAIN
========================= */

.container{
    max-width:1400px;
    margin:auto;
    padding:18px;
}

/* =========================
   USER SUMMARY
========================= */

.user-summary{
    background:linear-gradient(135deg,#061f5f,#063b9e 60%,#1261e8);
    border-radius:18px;
    padding:15px 20px;
    color:white;
    display:grid;
    grid-template-columns:1.35fr 1fr 1fr 1fr;
    align-items:center;
    box-shadow:var(--shadow);
    border:1px solid rgba(255,255,255,.20);
    margin-bottom:18px;
}

.user-profile{
    display:flex;
    align-items:center;
    gap:13px;
}

.avatar{
    width:58px;
    height:58px;
    border-radius:50%;
    background:linear-gradient(145deg,#fff,#dbeafe);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:30px;
    border:3px solid rgba(255,255,255,.55);
}

.welcome{
    font-size:12px;
    color:#dbeafe;
}

.username{
    font-size:18px;
    font-weight:800;
    margin-top:4px;
}

.role{
    display:inline-block;
    margin-left:5px;
    padding:4px 9px;
    border-radius:6px;
    background:#1769e8;
    font-size:10px;
    font-weight:800;
}

.summary-item{
    min-height:55px;
    padding:3px 20px;
    border-left:1px solid rgba(255,255,255,.18);
}

.summary-label{
    color:#dbeafe;
    font-size:11px;
    margin-bottom:5px;
}

.summary-value{
    font-size:18px;
    font-weight:900;
}

.summary-link{
    display:block;
    color:#dbeafe;
    font-size:11px;
    margin-top:4px;
}

/* =========================
   CATEGORIES
========================= */

.section-card{
    background:white;
    border-radius:18px;
    padding:15px;
    box-shadow:var(--shadow);
    margin-bottom:18px;
}

.categories{
    display:grid;
    grid-template-columns:repeat(8,1fr);
    gap:10px;
}

.category{
    min-height:86px;
    border-radius:14px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:6px;
    transition:.2s;
}

.category:hover{
    transform:translateY(-3px);
    background:#f2f6ff;
}

.category-icon{
    width:52px;
    height:52px;
    border-radius:50%;
    background:linear-gradient(145deg,#f9fafb,#edf2f7);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:27px;
    box-shadow:0 4px 12px rgba(0,0,0,.06);
}

.category-name{
    font-size:12px;
    font-weight:700;
}

/* =========================
   HERO
========================= */

.hero{
    min-height:335px;
    border-radius:20px;
    overflow:hidden;
    position:relative;
    background:
        radial-gradient(circle at 82% 35%,rgba(37,124,255,.75),transparent 23%),
        radial-gradient(circle at 88% 75%,rgba(255,196,0,.22),transparent 22%),
        linear-gradient(120deg,#03154a,#063b9e 65%,#092d75);
    color:white;
    box-shadow:0 12px 35px rgba(3,27,82,.22);
    margin-bottom:18px;
}

.hero-content{
    position:relative;
    z-index:2;
    width:57%;
    padding:42px 45px;
}

.hero-tag{
    display:inline-block;
    padding:9px 17px;
    border:1px solid rgba(255,255,255,.35);
    border-radius:30px;
    font-size:12px;
    font-weight:800;
    color:#fff;
    margin-bottom:22px;
}

.hero-title{
    font-size:44px;
    line-height:1.05;
    font-weight:900;
    letter-spacing:-1.5px;
}

.hero-title span{
    color:var(--gold);
}

.hero-text{
    margin-top:15px;
    font-size:15px;
    line-height:1.6;
    color:#e6efff;
    max-width:500px;
}

.shop-btn{
    display:inline-flex;
    align-items:center;
    gap:10px;
    margin-top:23px;
    padding:13px 22px;
    border-radius:10px;
    background:white;
    color:#063b9e;
    font-weight:900;
    font-size:13px;
    box-shadow:0 7px 18px rgba(0,0,0,.18);
}

.hero-art{
    position:absolute;
    right:3%;
    top:8%;
    width:40%;
    height:85%;
    display:flex;
    align-items:center;
    justify-content:center;
}

.globe{
    width:220px;
    height:220px;
    border-radius:50%;
    background:
        radial-gradient(circle at 35% 30%,#6eb6ff,#1261e8 55%,#031b52);
    border:4px solid rgba(255,255,255,.25);
    box-shadow:
        0 0 55px rgba(75,160,255,.55),
        inset -30px -20px 40px rgba(0,0,0,.28);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:105px;
}

.shopping-bag{
    position:absolute;
    left:8%;
    bottom:10%;
    font-size:105px;
    filter:drop-shadow(0 12px 15px rgba(0,0,0,.25));
}

.boxes{
    position:absolute;
    right:6%;
    bottom:8%;
    font-size:55px;
}

/* =========================
   TRUST BAR
========================= */

.trust-bar{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    background:white;
    border-radius:17px;
    box-shadow:var(--shadow);
    margin-bottom:24px;
    overflow:hidden;
}

.trust{
    padding:16px;
    display:flex;
    align-items:center;
    gap:11px;
    border-right:1px solid var(--border);
}

.trust:last-child{
    border-right:0;
}

.trust-icon{
    font-size:26px;
}

.trust-title{
    font-size:12px;
    font-weight:900;
}

.trust-text{
    font-size:10px;
    color:var(--muted);
    margin-top:3px;
}

/* =========================
   DEALS
========================= */

.section-heading{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:14px;
}

.section-title{
    font-size:20px;
    font-weight:900;
}

.section-title span{
    margin-right:7px;
}

.view-all{
    color:#1261e8;
    font-size:12px;
    font-weight:800;
}

.products{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:14px;
}

.product{
    background:white;
    border-radius:15px;
    overflow:hidden;
    border:1px solid #edf0f5;
    box-shadow:0 5px 18px rgba(16,24,40,.07);
    transition:.2s;
}

.product:hover{
    transform:translateY(-4px);
    box-shadow:0 12px 28px rgba(16,24,40,.12);
}

.product-image{
    height:190px;
    background:#f8fafc;
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
}

.product-image img{
    width:100%;
    height:100%;
    object-fit:contain;
    padding:10px;
}

.no-image{
    font-size:50px;
    opacity:.25;
}

.discount{
    position:absolute;
    top:10px;
    left:10px;
    background:#1769e8;
    color:white;
    padding:5px 8px;
    border-radius:5px;
    font-size:10px;
    font-weight:800;
}

.product-info{
    padding:12px;
}

.product-title{
    font-size:14px;
    font-weight:800;
    line-height:1.35;
    min-height:38px;
}

.rating{
    margin-top:7px;
    color:#fff;
    background:#159447;
    display:inline-block;
    padding:3px 6px;
    border-radius:5px;
    font-size:10px;
    font-weight:800;
}

.price{
    margin-top:8px;
    font-size:17px;
    font-weight:900;
    color:#101828;
}

.delivery{
    margin-top:6px;
    color:#475467;
    font-size:10px;
}

.product-bottom{
    display:flex;
    gap:7px;
    margin-top:11px;
}

.cart-btn{
    flex:1;
    background:#063b9e;
    color:white;
    border:0;
    border-radius:8px;
    padding:10px 5px;
    font-size:11px;
    font-weight:800;
    text-align:center;
}

.wishlist{
    width:40px;
    border:1px solid #cfd6e2;
    background:white;
    border-radius:8px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:18px;
}

/* =========================
   QUICK LINKS
========================= */

.quick-links{
    margin-top:24px;
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:12px;
}

.quick{
    background:white;
    border-radius:15px;
    padding:15px;
    display:flex;
    align-items:center;
    gap:10px;
    box-shadow:var(--shadow);
    border:1px solid #edf0f5;
}

.quick-icon{
    width:45px;
    height:45px;
    border-radius:12px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:23px;
    background:#eef4ff;
}

.quick-title{
    font-size:12px;
    font-weight:900;
}

.quick-sub{
    margin-top:3px;
    color:var(--muted);
    font-size:10px;
}

/* =========================
   BOTTOM NAV
========================= */

.bottom-nav{
    position:fixed;
    bottom:0;
    left:0;
    right:0;
    z-index:2000;
    height:86px;
    background:linear-gradient(135deg,#031b52,#063b9e);
    border-top:1px solid rgba(255,255,255,.18);
    box-shadow:0 -8px 25px rgba(0,0,0,.20);
}

.bottom-inner{
    max-width:900px;
    height:100%;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(5,1fr);
}

.bottom-item{
    min-width:125px;
    height:100%;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:4px;
    color:#cbd5e1;
    font-size:11px;
    font-weight:700;
    border-left:1px solid rgba(255,255,255,.05);
}

.bottom-item:first-child{
    border-left:0;
}

.bottom-icon{
    font-size:23px;
}

.bottom-item.active{
    color:white;
}

.bottom-item.active .bottom-icon{
    transform:translateY(-2px);
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:1000px){

    .header-main{
        flex-wrap:wrap;
    }

    .logo-box{
        min-width:auto;
    }

    .search-box{
        order:3;
        flex-basis:100%;
        max-width:none;
    }

    .user-summary{
        grid-template-columns:1fr 1fr;
        gap:12px;
    }

    .summary-item{
        border-left:0;
        border-top:1px solid rgba(255,255,255,.15);
        padding:10px 8px;
    }

    .categories{
        grid-template-columns:repeat(4,1fr);
    }

    .hero-content{
        width:70%;
    }

    .products{
        grid-template-columns:repeat(3,1fr);
    }

    .quick-links{
        grid-template-columns:repeat(3,1fr);
    }

    .trust-bar{
        grid-template-columns:repeat(3,1fr);
    }
}

@media(max-width:650px){

    body{
        padding-bottom:88px;
    }

    .container{
        padding:10px;
    }

    .header-main{
        padding:10px;
        gap:9px;
    }

    .menu-btn{
        width:42px;
        height:42px;
        font-size:22px;
    }

    .logo{
        font-size:23px;
    }

    .logo-tagline{
        font-size:9px;
    }

    .header-icon{
        width:40px;
        height:40px;
    }

    .user-summary{
        grid-template-columns:1fr 1fr;
        border-radius:15px;
        padding:12px;
    }

    .user-profile{
        grid-column:1 / -1;
    }

    .avatar{
        width:50px;
        height:50px;
    }

    .username{
        font-size:16px;
    }

    .summary-value{
        font-size:16px;
    }

    .summary-label{
        font-size:10px;
    }

    .categories{
        grid-template-columns:repeat(4,1fr);
        gap:5px;
    }

    .category{
        min-height:74px;
    }

    .category-icon{
        width:43px;
        height:43px;
        font-size:22px;
    }

    .category-name{
        font-size:10px;
    }

    .hero{
        min-height:390px;
    }

    .hero-content{
        width:100%;
        padding:28px 23px;
    }

    .hero-title{
        font-size:31px;
    }

    .hero-text{
        font-size:12px;
        max-width:90%;
    }

    .hero-art{
        width:100%;
        height:160px;
        right:0;
        top:auto;
        bottom:-4px;
    }

    .globe{
        width:125px;
        height:125px;
        font-size:58px;
    }

    .shopping-bag{
        left:12%;
        font-size:60px;
    }

    .boxes{
        right:10%;
        font-size:30px;
    }

    .trust-bar{
        grid-template-columns:repeat(2,1fr);
    }

    .trust{
        padding:12px 8px;
    }

    .trust-icon{
        font-size:21px;
    }

    .trust-title{
        font-size:10px;
    }

    .products{
        grid-template-columns:repeat(2,1fr);
        gap:9px;
    }

    .product-image{
        height:145px;
    }

    .product-info{
        padding:9px;
    }

    .product-title{
        font-size:12px;
    }

    .price{
        font-size:15px;
    }

    .quick-links{
        grid-template-columns:repeat(2,1fr);
    }

    .quick{
        padding:11px;
    }

    .bottom-nav{
        height:82px;
    }

    .bottom-inner{
        width:100%;
    }

    .bottom-item{
        min-width:0;
        width:100%;
        font-size:9px;
    }

    .bottom-icon{
        font-size:21px;
    }
}
</style>
</head>

<body>

<!-- =========================
     HEADER
========================= -->

<header class="header">

    <div class="header-main">

        <button class="menu-btn" type="button">
            ☰
        </button>

        <a href="{% url 'home' %}" class="logo-box">
            <div class="logo">
                <span class="white">YN COMMERCE</span>
                <span class="gold">INDIA</span>
            </div>
            <div class="logo-tagline">
                IMPORT. EXPORT. DELIVER.
            </div>
        </a>

        <div class="search-box">
            <span class="search-icon">⌕</span>
            <input
                type="search"
                placeholder="Search for products, brands & more..."
            >
        </div>

        <div class="header-actions">

            {% if user.is_authenticated %}

            <a href="{% url 'notifications' %}" class="header-icon">
                🔔
                <span class="badge">3</span>
            </a>

            <a href="{% url 'my_orders' %}" class="header-icon">
                🛒
            </a>

            {% else %}

            <a href="{% url 'login' %}" class="header-icon">
                👤
            </a>

            {% endif %}

        </div>

    </div>

</header>


<main class="container">

<!-- =========================
     USER SUMMARY
========================= -->

{% if user.is_authenticated %}

<section class="user-summary">

    <div class="user-profile">

        <div class="avatar">
            👤
        </div>

        <div>
            <div class="welcome">
                Welcome back,
            </div>

            <div class="username">
                {{ user.get_full_name|default:user.username }}

                <span class="role">
                    Buyer
                </span>
            </div>

            <div style="font-size:10px;color:#bfdbfe;margin-top:3px;">
                {{ user.referral_id|default:"YN MEMBER" }}
            </div>
        </div>

    </div>


    <div class="summary-item">

        <div class="summary-label">
            💰 Bonus Balance
        </div>

        <div class="summary-value">
            ₹{{ user.bonus_balance|default:"0.00"|floatformat:2 }}
        </div>

        <a class="summary-link" href="{% url 'bonus_balance_view' %}">
            View Details →
        </a>

    </div>


    <div class="summary-item">

        <div class="summary-label">
            ⭐ YN Points
        </div>

        <div class="summary-value">
            0
        </div>

        <a class="summary-link" href="{% url 'mlm_commission_history' %}">
            View Details →
        </a>

    </div>


    <div class="summary-item">

        <div class="summary-label">
            👥 Referral ID
        </div>

        <div class="summary-value">
            {{ user.referral_id|default:"YN MEMBER" }}
        </div>

        <a class="summary-link" href="{% url 'mlm_tree' %}">
            Refer & Earn →
        </a>

    </div>

</section>

{% endif %}


<!-- =========================
     CATEGORIES
========================= -->

<section class="section-card">

    <div class="categories">

        <a href="#" class="category">
            <div class="category-icon">📱</div>
            <div class="category-name">Electronics</div>
        </a>

        <a href="#" class="category">
            <div class="category-icon">👕</div>
            <div class="category-name">Fashion</div>
        </a>

        <a href="#" class="category">
            <div class="category-icon">🛋️</div>
            <div class="category-name">Home & Living</div>
        </a>

        <a href="#" class="category">
            <div class="category-icon">💄</div>
            <div class="category-name">Beauty</div>
        </a>

        <a href="#" class="category">
            <div class="category-icon">💎</div>
            <div class="category-name">Jewellery</div>
        </a>

        <a href="#" class="category">
            <div class="category-icon">🏀</div>
            <div class="category-name">Sports</div>
        </a>

        <a href="#" class="category">
            <div class="category-icon">📚</div>
            <div class="category-name">Books</div>
        </a>

        <a href="{% url 'dashboard' %}" class="category">
            <div class="category-icon">▦</div>
            <div class="category-name">More</div>
        </a>

    </div>

</section>


<!-- =========================
     HERO
========================= -->

<section class="hero">

    <div class="hero-content">

        <div class="hero-tag">
            ✓ YN COMMERCE INDIA
        </div>

        <h1 class="hero-title">
            BEST QUALITY.<br>
            <span>BEST PRICES.</span>
        </h1>

        <p class="hero-text">
            Your trusted Import, Export & Commerce marketplace.
            Discover quality products at competitive prices.
        </p>

        <a href="#deals" class="shop-btn">
            SHOP NOW →
        </a>

    </div>


    <div class="hero-art">

