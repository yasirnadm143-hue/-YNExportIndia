@login_required
def mlm_commission_view(request):
    """
    Show the logged-in user's MLM commission summary
    and level-wise commission transactions.
    """

    from django.db.models import Sum
    from .models import CommissionTransaction

    user = request.user

    transactions = (
        CommissionTransaction.objects
        .filter(beneficiary=user)
        .select_related("source_user", "order", "order__product")
        .order_by("-created_at")
    )

    total_commission = (
        transactions.aggregate(total=Sum("amount"))["total"] or 0
    )

    level_summary = (
        transactions
        .values("level")
        .annotate(
            total=Sum("amount")
        )
        .order_by("level")
    )

    direct_downline = CustomUser.objects.filter(
        upline=user
    ).order_by("date_joined")

    return render(
        request,
        "accounts/mlm_commission.html",
        {
            "user": user,
            "transactions": transactions,
            "level_summary": level_summary,
            "total_commission": total_commission,
            "direct_downline": direct_downline,
        },
    )


