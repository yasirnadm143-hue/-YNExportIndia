<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>YN Commerce India</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f7f8fa;
            color: #182033;
            padding-bottom: 82px;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* =========================
           TOP HEADER
        ========================== */

        .top-header {
            background: white;
            padding: 16px 16px 10px;
        }

        .top-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .welcome small {
            display: block;
            color: #9aa1ad;
            font-size: 13px;
            margin-bottom: 3px;
        }

        .welcome h2 {
            font-size: 22px;
            font-weight: 800;
            color: #182033;
        }

        .profile-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1688ff, #16c7b7);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 21px;
            box-shadow: 0 5px 14px rgba(20,130,220,.2);
        }


        .hamburger-btn {
            width: 44px;
            height: 44px;
            border: 0;
            border-radius: 50%;
            background: #f1f3f6;
            color: #182033;
            font-size: 23px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* =========================
           SEARCH
        ========================== */

        .search-box {
            margin-top: 16px;
            display: flex;
            background: #f1f3f6;
            border-radius: 15px;
            height: 48px;
            overflow: hidden;
            border: 1px solid #eceef2;
        }

        .search-box input {
            flex: 1;
            border: 0;
            outline: 0;
            background: transparent;
            padding: 0 16px;
            font-size: 14px;
            color: #222;
        }

        .search-box button {
            width: 52px;
            border: 0;
            background: #ffb400;
            font-size: 20px;
            cursor: pointer;
        }

        /* =========================
           MAIN
        ========================== */

        .container {
            max-width: 1050px;
            margin: auto;
            padding: 12px 14px 30px;
        }

        /* =========================
           HERO
        ========================== */

        .hero {
            min-height: 170px;
            border-radius: 22px;
            padding: 25px 22px;
            background:
                linear-gradient(135deg, #ffe33d, #ffd01a);
            display: flex;
            align-items: center;
            justify-content: space-between;
            overflow: hidden;
            position: relative;
            margin-bottom: 20px;
        }

        .hero-content {
            max-width: 63%;
            position: relative;
            z-index: 2;
        }

        .hero small {
            font-size: 12px;
            font-weight: 700;
            color: #665600;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .hero h1 {
            font-size: 25px;
            line-height: 1.1;
            margin: 7px 0 9px;
            color: #171717;
        }

        .hero p {
            font-size: 13px;
            line-height: 1.4;
            color: #4d4300;
            margin-bottom: 14px;
        }

        .hero-btn {
            display: inline-block;
            background: #171717;
            color: white;
            padding: 10px 17px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .hero-icon {
            font-size: 72px;
            transform: rotate(-8deg);
            position: relative;
            z-index: 1;
            opacity: .95;
        }

        /* =========================
           CATEGORY
        ========================== */

        .section-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 20px 2px 12px;
        }

        .section-title h3 {
            font-size: 19px;
            font-weight: 800;
        }

        .section-title a {
            font-size: 12px;
            color: #1681dc;
            font-weight: 600;
        }

        .categories {
            display: flex;
            gap: 12px;
            overflow-x: auto;
            padding: 2px 2px 8px;
            scrollbar-width: none;
        }

        .categories::-webkit-scrollbar {
            display: none;
        }

        .category {
            min-width: 76px;
            text-align: center;
            flex-shrink: 0;
        }

        .category-icon {
            width: 62px;
            height: 62px;
            margin: auto;
            border-radius: 50%;
            background: white;
            border: 1px solid #e8e9ed;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 27px;
            box-shadow: 0 3px 10px rgba(0,0,0,.04);
        }

        .category span {
            display: block;
            margin-top: 7px;
            font-size: 11px;
            color: #686f7d;
            font-weight: 600;
        }

        .category.active .category-icon {
            background: #ffbd00;
            border-color: #ffbd00;
        }

        .category.active span {
            color: #111;
        }

        /* =========================
           MESSAGE
        ========================== */

        .alert-box {
            background: #eaf8ed;
            color: #26733a;
            border: 1px solid #c9ebd0;
            padding: 11px 13px;
            border-radius: 12px;
            margin-bottom: 14px;
            font-size: 13px;
            font-weight: 700;
        }

        /* =========================
           PRODUCTS
        ========================== */

        .product-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .product-card {
            background: white;
            border-radius: 17px;
            overflow: hidden;
            position: relative;
            border: 1px solid #eceef2;
            box-shadow: 0 4px 13px rgba(20,30,50,.055);
            transition: .2s;
        }

        .product-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(20,30,50,.10);
        }

        .product-image {
            height: 175px;
            background: #f4f5f7;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        .top-badge {
            position: absolute;
            top: 9px;
            left: 9px;
            background: #1f8b4c;
            color: white;
            font-size: 9px;
            font-weight: 800;
            padding: 4px 7px;
            border-radius: 6px;
            z-index: 2;
        }

        .heart {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 31px;
            height: 31px;
            border-radius: 50%;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
            z-index: 2;
        }

        .product-info {
            padding: 12px;
        }

        .product-info h4 {
            font-size: 14px;
            font-weight: 700;
            color: #252a35;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 7px;
        }

        .price {
            font-size: 17px;
            color: #168c48;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .view-btn {
            display: block;
            width: 100%;
            text-align: center;
            background: #ff6b18;
            color: white;
            border-radius: 10px;
            padding: 10px 5px;
            font-size: 12px;
            font-weight: 800;
        }

        .empty-box {
            grid-column: 1 / -1;
            background: white;
            border-radius: 16px;
            padding: 35px 20px;
            text-align: center;
            color: #777;
        }

        /* =========================
           BOTTOM NAV
        ========================== */

        .bottom-nav {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            height: 72px;
            background: rgba(255,255,255,.98);
            border-top: 1px solid #e7e9ed;
            box-shadow: 0 -5px 20px rgba(0,0,0,.07);
            display: flex;
            align-items: center;
            justify-content: space-around;
            z-index: 9999;
        }

        .nav-item {
            flex: 1;
            text-align: center;
            color: #7b818c;
            font-size: 10px;
            font-weight: 700;
        }

        .nav-icon {
            font-size: 22px;
            line-height: 25px;
            margin-bottom: 2px;
        }

        .nav-item.active {
            color: #1681dc;
        }

        /* =========================
           DESKTOP
        ========================== */

        @media (min-width: 700px) {

            .top-header {
                padding: 18px calc((100% - 1050px)/2 + 14px);
            }

            .container {
                padding-top: 20px;
            }

            .hero {
                min-height: 220px;
                padding: 35px;
            }

            .hero h1 {
                font-size: 34px;
            }

            .hero-icon {
                font-size: 105px;
            }

            .product-grid {
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }

            .product-image {
                height: 220px;
            }
        }

    </style>
</head>

<body>

<!-- =========================
     HEADER
========================== -->

<header class="top-header">

    <div class="top-row">

        <div class="welcome">

            {% if user.is_authenticated %}
                <small>Hi,</small>
                <h2>{{ user.username }} 👋</h2>
            {% else %}
                <small>Welcome to</small>
                <h2>YN Commerce India 👋</h2>
            {% endif %}

        </div>

        <div style="display:flex;align-items:center;gap:10px;position:relative;">

            {% if user.is_authenticated %}
                <a href="{% url 'dashboard' %}" class="profile-btn">
                    👤
                </a>
            {% else %}
                <a href="{% url 'login' %}" class="profile-btn">
                    🔑
                </a>
            {% endif %}

            <button type="button"
                    class="hamburger-btn"
                    onclick="toggleHomeMenu()"
                    aria-label="Menu">
                ☰
            </button>

            <div id="homeMenu"
                 style="display:none;position:absolute;right:0;top:52px;width:235px;background:white;border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,.16);overflow:hidden;z-index:9999;">

                <a href="{% url 'home' %}" style="display:block;padding:14px 16px;border-bottom:1px solid #eee;">🏠 Home</a>
                <a href="{% url 'profile' %}" style="display:block;padding:14px 16px;border-bottom:1px solid #eee;">👤 My Profile</a>
                <a href="{% url 'my_orders' %}" style="display:block;padding:14px 16px;border-bottom:1px solid #eee;">📦 My Orders</a>

                <a href="{% url 'notifications' %}" style="display:block;padding:14px 16px;border-bottom:1px solid #eee;">🔔 Notifications</a>
                <a href="{% url 'user_settings' %}" style="display:block;padding:14px 16px;border-bottom:1px solid #eee;">⚙️ Settings</a>
                <a href="{% url 'customer_support' %}" style="display:block;padding:14px 16px;border-bottom:1px solid #eee;">🛟 Customer Support</a>

                {% if user.is_staff or user.is_superuser %}
                    <a href="{% url 'upload_product' %}" style="display:block;padding:14px 16px;border-bottom:1px solid #eee;">📤 Upload Product</a>
                {% endif %}

                {% if user.is_authenticated %}
                    <form action="{% url 'logout' %}" method="post" style="margin:0;">
                        {% csrf_token %}
                        <button type="submit" style="width:100%;padding:14px 16px;border:0;background:white;text-align:left;color:#d32f2f;font-weight:700;font-size:14px;">
                            🚪 Logout
                        </button>
                    </form>
                {% else %}
                    <a href="{% url 'login' %}" style="display:block;padding:14px 16px;border-bottom:1px solid #eee;">🔑 Login</a>
                    <a href="{% url 'register' %}" style="display:block;padding:14px 16px;">📝 Register</a>
                {% endif %}

            </div>
        </div>

    </div>

    <form method="GET"
          action="{% url 'home' %}"
          class="search-box">

        <input
            type="text"
            name="q"
            placeholder="Search products, export..."
            value="{{ query }}"
        >

        <button type="submit">🔍</button>

    </form>

</header>


<!-- =========================
     MAIN
========================== -->

<main class="container">

    {% if messages %}

        {% for message in messages %}

            <div class="alert-box">
                ✨ {{ message }}
            </div>

        {% endfor %}

    {% endif %}


    <!-- HERO -->

    <section class="hero">

        <div class="hero-content">

            <small>YN COMMERCE INDIA</small>

            <h1>
                Shop The<br>
                New Products
            </h1>

            <p>
                Discover trusted products and
                grow your business with YN Commerce India.
            </p>

            <a href="#products" class="hero-btn">
                SHOP NOW →
            </a>

        </div>

        <div class="hero-icon">
            🛍️
        </div>

    </section>


    <!-- CATEGORIES -->

    <div class="section-title">

        <h3>Categories</h3>

        <a href="{% url 'home' %}">
            View all
        </a>

    </div>


    <div class="categories">

        <a href="{% url 'home' %}" class="category active">
            <div class="category-icon">🛍️</div>
            <span>All</span>
        </a>

        <a href="{% url 'home' %}?q=Shirt" class="category">
            <div class="category-icon">👕</div>
            <span>Fashion</span>
        </a>

        <a href="{% url 'home' %}?q=Earphone" class="category">
            <div class="category-icon">🎧</div>
            <span>Electronics</span>
        </a>

        <a href="{% url 'home' %}?q=Bag" class="category">
            <div class="category-icon">🎒</div>
            <span>Bags</span>
        </a>

        <a href="{% url 'home' %}?q=Beauty" class="category">
            <div class="category-icon">💄</div>
            <span>Beauty</span>
        </a>

        <a href="{% url 'home' %}?q=Commerce" class="category">
            <div class="category-icon">🚢</div>
            <span>Commerce</span>
        </a>

    </div>


    <!-- PRODUCTS -->

    <div class="section-title" id="products">

        <h3>
            {% if query %}
                Search Results
            {% else %}
                New Arrivals
            {% endif %}
        </h3>

        <a href="{% url 'home' %}">
            View all
        </a>

    </div>


    <div class="product-grid">

        {% if products %}

            {% for product in products %}

                <article class="product-card">

                    <span class="top-badge">
                        TOP
                    </span>

                    <div class="heart">
                        ♡
                    </div>

                    <div class="product-image">

                        {% if product.image %}

                            <img
                                src="{{ product.image.url }}"
                                alt="{{ product.title }}"
                                loading="lazy"
                            >

                        {% else %}

                            <span style="color:#aaa;">
                                No Image
                            </span>

                        {% endif %}

                    </div>


                    <div class="product-info">

                        <h4>
                            {{ product.title }}
                        </h4>

                        <div class="price">
                            ₹ {{ product.price }}
                        </div>

                        <a
                            href="{% url 'product_detail' product.id %}"
                            class="view-btn"
                        >
                            View Details
                        </a>

                    </div>

                </article>

            {% endfor %}

        {% else %}

            <div class="empty-box">

                <h3>No Products Found</h3>

                <p style="margin-top:8px;">
                    Try another search keyword.
                </p>

            </div>

        {% endif %}

    </div>

</main>


<!-- =========================
     BOTTOM NAVIGATION
========================== -->

<nav class="bottom-nav">

    <a
        href="{% url 'home' %}"
        class="nav-item active"
    >
        <div class="nav-icon">🏠</div>
        Home
    </a>


    <a
        href="{% url 'home' %}?q=Commerce"
        class="nav-item"
    >
        <div class="nav-icon">🚢</div>
        Commerce
    </a>





    <a
        href="{% url 'dashboard' %}"
        class="nav-item"
    >
        <div class="nav-icon">📦</div>
        Orders
    </a>


    <a
        href="{% url 'customer_support' %}"
        class="nav-item"
    >
        <div class="nav-icon">🛠️</div>
        Support
    </a>

</nav>


<script>
function toggleHomeMenu() {
    const menu = document.getElementById("homeMenu");
    if (menu) {
        menu.style.display =
            menu.style.display === "block" ? "none" : "block";
    }
}

document.addEventListener("click", function(event) {
    const menu = document.getElementById("homeMenu");
    const button = document.querySelector(".hamburger-btn");

    if (menu && button &&
        !menu.contains(event.target) &&
        !button.contains(event.target)) {
        menu.style.display = "none";
    }
});
</script>

</body>
</html>
