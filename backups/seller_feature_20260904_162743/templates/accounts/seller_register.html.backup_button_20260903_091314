{% extends "base.html" %}

{% block content %}
<div class="seller-registration">
    <h1>Seller Registration</h1>
    <p>Complete your seller verification details to start selling.</p>

    <form method="post" enctype="multipart/form-data">
        {% csrf_token %}

        {{ form.non_field_errors }}

        {% for field in form %}
            <div class="form-group">
                <label for="{{ field.id_for_label }}">{{ field.label }}</label>
                {{ field }}
                {% if field.errors %}
                    <div class="error">
                        {{ field.errors }}
                    </div>
                {% endif %}
            </div>
        {% endfor %}

        <button type="submit">Submit Seller Registration</button>
    </form>
</div>
{% endblock %}
