<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Network - YN Commerce India</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 15px;
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            color: #222;
        }

        .container {
            max-width: 1100px;
            margin: auto;
        }

        .header,
        .card {
            background: #fff;
            border-radius: 14px;
            padding: 20px;
            margin-bottom: 18px;
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
        }

        h1,
        h2,
        h3 {
            margin-top: 0;
        }

        .header h1 {
            margin-bottom: 8px;
        }

        .muted {
            color: #666;
        }

        .back {
            display: inline-block;
            margin-top: 12px;
            padding: 10px 16px;
            border-radius: 8px;
            background: #2874f0;
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-bottom: 18px;
        }

        .stat {
            background: white;
            padding: 18px;
            border-radius: 14px;
            box-shadow: 0 3px 12px rgba(0,0,0,.07);
        }

        .stat-title {
            color: #666;
            font-size: 14px;
        }

        .stat-value {
            font-size: 26px;
            font-weight: bold;
            margin-top: 6px;
        }

        .current-user {
            border: 2px solid #2874f0;
            border-radius: 14px;
            padding: 18px;
            background: #f7fbff;
            margin-bottom: 20px;
        }

        .current-user h2 {
            color: #1251b8;
            margin-bottom: 8px;
        }

        .upline-box {
            background: #fff8e8;
            border: 1px solid #f0d48a;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 18px;
        }

        .upline-link {
            display: inline-block;
            margin-top: 8px;
            padding: 8px 14px;
            border-radius: 7px;
            background: #f0a500;
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .members {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }

        .member {
            background: white;
            border: 1px solid #e1e5ea;
            border-radius: 12px;
            padding: 16px;
            box-shadow: 0 2px 8px rgba(0,0,0,.05);
        }

        .member h3 {
            margin-bottom: 10px;
            color: #2874f0;
        }

        .member p {
            margin: 7px 0;
            font-size: 14px;
        }

        .view-btn {
            display: inline-block;
            margin-top: 10px;
            padding: 9px 13px;
            border-radius: 7px;
            background: #2874f0;
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .empty {
            padding: 25px;
            text-align: center;
            color: #777;
            background: #fafafa;
            border-radius: 10px;
        }

        @media (max-width: 800px) {
            .stats {
                grid-template-columns: 1fr;
            }

            .members {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <!-- HEADER -->

    <div class="header">

        <h1>🌳 My Network</h1>

        <div class="muted">
            YN Commerce India MLM Network
        </div>

        <a href="{% url 'dashboard' %}" class="back">
            ← Dashboard
        </a>

    </div>


    <!-- CURRENT USER -->

    <div class="current-user">

        <h2>👤 {{ current_user.username }}</h2>

        <p>
            <strong>Referral ID:</strong>
            {{ current_user.referral_id|default:"-" }}
        </p>

        <p>
            <strong>Rank:</strong>
            {{ current_user.rank|default:"Member" }}
        </p>

        <p>
            <strong>Joining Date:</strong>
            {{ current_user.date_joined|date:"d M Y, h:i A" }}
        </p>

    </div>


    <!-- STATS -->

    <div class="stats">

        <div class="stat">

            <div class="stat-title">
                Direct Downline
            </div>

            <div class="stat-value">
                {{ downlines|length }}
            </div>

        </div>


        <div class="stat">

            <div class="stat-title">
                Total Network
            </div>

            <div class="stat-value">
                {{ total_team }}
            </div>

        </div>


        <div class="stat">

            <div class="stat-title">
                MLM Level
            </div>

            <div class="stat-value">
                {{ current_user.mlm_level|default:"20" }}
            </div>

        </div>

    </div>


    <!-- UPLINE -->

    {% if parent_user %}

    <div class="upline-box">

        <strong>⬆️ Upline</strong>

        <p>
            {{ parent_user.username }}
        </p>

        <p>
            Referral ID:
            {{ parent_user.referral_id|default:"-" }}
        </p>

        <a
            href="{% url 'mlm_tree' %}?user={{ parent_user.id }}"
            class="upline-link"
        >
            View Upline Network
        </a>

    </div>

    {% else %}

    <div class="upline-box">

        <strong>⬆️ Upline</strong>

        <p>No Upline</p>

    </div>

    {% endif %}


    <!-- DOWNLINE -->

    <div class="card">

        <h2>
            👥 Direct Downline
        </h2>

        <p class="muted">
            Click any username to open that member's network.
        </p>


        {% if downlines %}

        <div class="members">

            {% for member in downlines %}

            <div class="member">

                <h3>
                    👤 {{ member.username }}
                </h3>

                <p>
                    <strong>Referral ID:</strong>
                    {{ member.referral_id|default:"-" }}
                </p>

                <p>
                    <strong>Rank:</strong>
                    {{ member.rank|default:"Member" }}
                </p>

                <p>
                    <strong>MLM Level:</strong>
                    {{ member.mlm_level|default:"20" }}
                </p>

                <p>
                    <strong>Joining:</strong>
                    {{ member.date_joined|date:"d M Y, h:i A" }}
                </p>

                <p>
                    <strong>Direct Downline:</strong>
                    {{ member.downlines.count }}
                </p>

                <a
                    href="{% url 'mlm_tree' %}?user={{ member.id }}"
                    class="view-btn"
                >
                    View Network →
                </a>

            </div>

            {% endfor %}

        </div>

        {% else %}

        <div class="empty">

            No direct downline members found.

            <br><br>

            Share your referral link to grow your network.

        </div>

        {% endif %}

    </div>


    <!-- MLM COMMISSION -->

    <div class="card">

        <h2>💰 MLM Commission</h2>

        <p class="muted">
            View your complete level-wise commission and transactions.
        </p>

        <a
            href="{% url 'mlm_commission' %}"
            class="back"
        >
            View MLM Commission →
        </a>

    </div>

</div>

</body>
</html>
