<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>YN INDIA | Seller Dashboard</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#f4f7fb;
    color:#172033;
}

.header{
    background:linear-gradient(135deg,#061b4f,#075be8);
    color:white;
    padding:18px;
}

.header-inner{
    max-width:1200px;
    margin:auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
}

.logo{
    font-size:27px;
    font-weight:900;
}

.logo span{
    color:#ffd000;
}

.header a{
    color:white;
    text-decoration:none;
    font-weight:bold;
}

.container{
    max-width:1200px;
    margin:auto;
    padding:22px 16px 90px;
}

.welcome{
    background:white;
    border-radius:20px;
    padding:25px;
    box-shadow:0 8px 25px rgba(0,0,0,.07);
    margin-bottom:20px;
}

.welcome h1{
    font-size:27px;
    margin-bottom:7px;
}

.welcome p{
    color:#697386;
}

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.card{
    background:white;
    border-radius:18px;
    padding:22px;
    box-shadow:0 7px 24px rgba(0,0,0,.06);
}

.card .icon{
    font-size:28px;
}

.card .title{
    color:#697386;
    font-size:13px;
    margin-top:12px;
}

.card .value{
    font-size:27px;
    font-weight:900;
    margin-top:5px;
}

.actions{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:15px;
    margin-top:20px;
}

.action{
    background:white;
    border-radius:18px;
    padding:22px;
    text-decoration:none;
    color:#172033;
    box-shadow:0 7px 24px rgba(0,0,0,.06);
    transition:.2s;
}

.action:hover{
    transform:translateY(-3px);
}

.action strong{
    display:block;
    font-size:18px;
    margin-bottom:5px;
}

.action span{
    color:#697386;
    font-size:13px;
}

.primary{
    background:linear-gradient(135deg,#ff6b00,#ff8f00);
    color:white;
}

@media(max-width:800px){
    .stats{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:500px){
    .header-inner{
        align-items:flex-start;
    }

    .stats{
        grid-template-columns:1fr 1fr;
        gap:10px;
    }

    .card{
        padding:16px;
    }

    .card .value{
        font-size:22px;
    }

    .actions{
        grid-template-columns:1fr;
    }
}
</style>
</head>

<body>

<header class="header">
    <div class="header-inner">

        <div class="logo">
            YN <span>INDIA</span>
        </div>

        <a href="{% url 'home' %}">
            🏠 Marketplace
        </a>

    </div>
</header>

<main class="container">

    <section class="welcome">
        <h1>Seller Dashboard 👋</h1>
        <p>
            Welcome, {{ user.get_full_name|default:user.username }}.
            Manage your products and orders from one place.
        </p>
    </section>

    <section class="stats">

        <div class="card">
            <div class="icon">📦</div>
            <div class="title">Total Products</div>
            <div class="value">{{ total_products }}</div>
        </div>

        <div class="card">
            <div class="icon">🛒</div>
            <div class="title">Total Orders</div>
            <div class="value">{{ total_orders }}</div>
        </div>

        <div class="card">
            <div class="icon">🚚</div>
            <div class="title">Delivered Orders</div>
            <div class="value">{{ delivered_orders }}</div>
        </div>

        <div class="card">
            <div class="icon">₹</div>
            <div class="title">Delivered Sales</div>
            <div class="value">₹{{ total_sales }}</div>
        </div>

    </section>

    <section class="actions">

        <a class="action primary"
           href="{% url 'upload_product' %}">
            <strong>＋ Add New Product</strong>
            <span>Upload a product to YN INDIA Marketplace</span>
        </a>

        <a class="action"
           href="{% url 'seller_products' %}">
            <strong>📦 My Products</strong>
            <span>View and manage your products</span>
        </a>

        <a class="action"
           href="{% url 'my_orders' %}">
            <strong>🛒 Orders</strong>
            <span>View marketplace orders</span>
        </a>

        <a class="action"
           href="{% url 'home' %}">
            <strong>🏪 Marketplace</strong>
            <span>Return to YN INDIA shopping</span>
        </a>

    </section>

</main>

</body>
</html>
