@login_required
def my_orders(request):

    orders = Order.objects.filter(
        user=request.user
    ).select_related(
        "product"
    ).order_by(
        "-created_at"
    )

    return render(
        request,
        "accounts/my_orders.html",
        {
            "orders": orders
        }
    )


