<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>YN Commerce India - Dashboard</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#f5f5f5;
}

.header{
background:#1565c0;
color:white;
padding:15px;
display:flex;
justify-content:space-between;
align-items:center;
}

.header a{
color:white;
text-decoration:none;
font-weight:bold;
}

.container{
width:95%;
max-width:900px;
margin:auto;
padding:15px;
}

.card{
background:white;
border-radius:10px;
padding:15px;
margin-bottom:15px;
box-shadow:0 2px 10px rgba(0,0,0,.1);
}

.rank{
background:linear-gradient(45deg,#ff9800,#ff5722);
color:white;
text-align:center;
}

.rank h2{
margin-top:8px;
}

.info p{
margin:10px 0;
font-size:15px;
}

.btn{
display:inline-block;
padding:10px 15px;
background:#1565c0;
color:white;
text-decoration:none;
border-radius:6px;
margin-top:8px;
}

.btn-green{
background:#28a745;
}

.btn-red{
background:#dc3545;
}

input{
width:100%;
padding:10px;
margin-top:8px;
border:1px solid #ccc;
border-radius:5px;
}

table{
width:100%;
border-collapse:collapse;
margin-top:10px;
}

table th{
background:#1565c0;
color:white;
padding:10px;
}

table td{
padding:10px;
border:1px solid #ddd;
}

.copy-btn{
background:#28a745;
color:white;
border:none;
padding:8px 12px;
border-radius:5px;
cursor:pointer;
margin-top:8px;
}

</style>

</head>

<body>

<div class="header">

<h2>YN Commerce India</h2>

<a href="{% url 'home' %}">Home</a>

</div>

<div class="container">

<div class="card rank">

<h4>Your Current Rank</h4>

<h2>{{ request.user.rank|default:"Bronze Member 🥉" }}</h2>

</div>

<div class="card info">



<h3>My MLM Information</h3>

<div style="display:flex; gap:10px; flex-wrap:wrap; margin:10px 0 15px;">

    <a
        href="{% url 'mlm_tree' %}"
        style="
            display:inline-block;
            padding:12px 20px;
            background:#2874f0;
            color:#fff;
            text-decoration:none;
            border-radius:8px;
            font-weight:bold;
        "
    >
        🌳 My Network
    </a>

    <a
        href="{% url 'mlm_commission' %}"
        style="
            display:inline-block;
            padding:12px 20px;
            background:#198754;
            color:#fff;
            text-decoration:none;
            border-radius:8px;
            font-weight:bold;
        "
    >
        💰 MLM Commission
    </a>

</div>


<a
    href="{% url 'mlm_commission' %}"
    style="
        display:inline-block;
        margin:10px 0 15px;
        padding:12px 20px;
        background:#2874f0;
        color:#fff;
        text-decoration:none;
        border-radius:8px;
        font-weight:bold;
    "
>
    💰 View MLM Commission
</a>


<p><b>Username :</b> {{ request.user.username }}</p>

<p><b>Referral ID :</b> {{ request.user.referral_id }}</p>

<p><b>Upline :</b>
{% if request.user.upline %}
{{ request.user.upline.username }}
{% else %}
No Upline
{% endif %}
</p>

<p><b>Total Team :</b> {{ referral_count }}</p>

<p><b>Wallet :</b> ₹ {{ wallet.balance|default:"0.00" }}</p>

<p><b>Total Referral Income :</b>
₹ {{ total_income|default:"0.00" }}
</p>

<input
id="referralLink"
type="text"
readonly
value="{{ request.user.referral_link }}"
>

<button
class="copy-btn"
onclick="copyReferral()">

Copy Referral Link

</button>

<br><br>



<a
href="#"
class="btn btn-green">

Recharge

</a>

<a
href="#"
class="btn btn-red">

Withdraw

</a>

</div>
<div class="card">

<h3>My Orders</h3>

{% if orders %}

<table>

<tr>
<th>Product</th>
<th>Qty</th>
<th>Total</th>
<th>Status</th>
</tr>

{% for order in orders %}

<tr>

<td>{{ order.product.title }}</td>

<td>{{ order.quantity }}</td>

<td>₹ {{ order.total_price }}</td>

<td>{{ order.status }}</td>

</tr>

{% endfor %}

</table>

{% else %}

<p>No orders available.</p>

{% endif %}

</div>

<div class="card">

<h3>Notifications</h3>

{% if notifications %}

<ul>

{% for n in notifications %}

<li style="margin-bottom:8px;">
{{ n.message }}
</li>

{% endfor %}

</ul>

{% else %}

<p>No notifications.</p>

{% endif %}

</div>

</div>

<script>

function copyReferral(){

var copyText=document.getElementById("referralLink");

copyText.select();

copyText.setSelectionRange(0,99999);

navigator.clipboard.writeText(copyText.value);

alert("Referral Link Copied Successfully");

}

</script>

</body>

</html>
