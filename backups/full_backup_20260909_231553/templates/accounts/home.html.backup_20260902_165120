========================= -->

<section class="trust-bar">

    <div class="trust">
        <div class="trust-icon">🛡️</div>
        <div>
            <div class="trust-title">100% Original</div>
            <div class="trust-text">Genuine Products</div>
        </div>
    </div>

    <div class="trust">
        <div class="trust-icon">↩️</div>
        <div>
            <div class="trust-title">Easy Returns</div>
            <div class="trust-text">7 Days Return</div>
        </div>
    </div>

    <div class="trust">
        <div class="trust-icon">🔒</div>
        <div>
            <div class="trust-title">Secure Payment</div>
            <div class="trust-text">Protected Checkout</div>
        </div>
    </div>

    <div class="trust">
        <div class="trust-icon">🚚</div>
        <div>
            <div class="trust-title">Fast Delivery</div>
            <div class="trust-text">Pan India Delivery</div>
        </div>
    </div>

    <div class="trust">
        <div class="trust-icon">🎧</div>
        <div>
            <div class="trust-title">24/7 Support</div>
            <div class="trust-text">We're Here</div>
        </div>
    </div>

</section>


<!-- =========================
     TOP DEALS
========================= -->

<section id="deals">

    <div class="section-heading">

        <h2 class="section-title">
            <span>🔥</span> Top Deals of the Day
        </h2>

        <a href="#deals" class="view-all">
            View All →
        </a>

    </div>


    <div class="products">

        {% for product in products|slice:":8" %}

        <article class="product">

            <div class="product-image">

                <div class="discount">
                    DEAL
                </div>

                {% if product.image %}
                    <img
                        src="{{ product.image.url }}"
                        alt="{{ product.title }}"
                    >
                {% else %}
                    <div class="no-image">
                        🛍️
                    </div>
                {% endif %}

            </div>


            <div class="product-info">

                <div class="product-title">
                    {{ product.title }}
                </div>

                <span class="rating">
                    ★ 4.5
                </span>

                <div class="price">
                    ₹{{ product.price|floatformat:2 }}
                </div>

                <div class="delivery">
                    🚚 Free Delivery
                </div>

                <div class="product-bottom">

                    <a
                        href="{% url 'product_detail' product.pk %}"
                        class="cart-btn"
                    >
                        🛒 View Product
                    </a>

                    <button
                        class="wishlist"
                        type="button"
                    >
                        ♡
                    </button>

                </div>

            </div>

        </article>

        {% empty %}

        <div style="
            grid-column:1/-1;
            background:white;
            padding:40px;
            border-radius:15px;
            text-align:center;
            color:#667085;
        ">
            No products available yet.
        </div>

        {% endfor %}

    </div>

</section>


